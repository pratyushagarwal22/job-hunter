# career-ops — Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# NOTE: Never commit secrets. `.env` is gitignored.
#
# ── Gemini Integration (Issue #344) ─────────────────────────────────────────
# Required for: node gemini-eval.mjs "JD text here"
# Free API key: https://aistudio.google.com/apikey
# Free tier: 15 RPM / 1M tokens/day with gemini-2.0-flash (no billing needed)
GEMINI_API_KEY=your_gemini_api_key_here
#
# Optional: Override default Gemini model
# GEMINI_MODEL=gemini-2.0-flash
#
# ── Google Sheets/Drive (service account) ────────────────────────────────────
# Used by the jobhunt automation pipeline (Command Center + Drive assets).
#
# Path should be relative to repo root or absolute.
GOOGLE_APPLICATION_CREDENTIALS=secrets/google-service-account.json
#
# Google Drive root folder (the JOBHUNT folder you created)
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_drive_folder_id_here
#
# Google Sheet ID (the "JOBHUNT Command Center" sheet)
GOOGLE_SHEET_ID=your_sheet_id_here

# ── Google Drive OAuth (recommended for personal Gmail) ───────────────────────
# Needed because service accounts can't upload into a user's "My Drive".
# 1) Put OAuth client JSON at GOOGLE_OAUTH_CLIENT_PATH
# 2) Run: node jobhunt/google-oauth-init.mjs
GOOGLE_OAUTH_CLIENT_PATH=secrets/google-oauth-client.json
GOOGLE_OAUTH_TOKEN_PATH=secrets/google-oauth-token.json
#
# ── Anthropic (Claude API) ──────────────────────────────────────────────────
# Required for: npm run jobhunt:claude-ping, jobhunt:ai-*, and npm run jobhunt:stage2 (Claude assets)
# Console: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
#
# Optional: fallback model if a task-specific var below is unset
# ANTHROPIC_MODEL=claude-haiku-4-5
#
# Optional: per-task models (JOBHUNT AI scripts — see jobhunt/ai-test/)
# ANTHROPIC_MODEL_SCORE=claude-haiku-4-5
# ANTHROPIC_MODEL_LINKEDIN=claude-haiku-4-5
# ANTHROPIC_MODEL_RESUME=claude-sonnet-4-20250514
# ANTHROPIC_MODEL_OUTREACH=claude-sonnet-4-20250514
#
# ── Apollo.io (Stage 3 contact enrichment) ──────────────────────────────────
# Required for: npm run jobhunt:stage3 (recruiter / hiring-manager lookup per company)
# Get a key: https://developer.apollo.io/ (master key under your account settings)
# Notes:
#   - /v1/people/match (email reveal) is credit-metered. Free plans have a small
#     monthly pool; upgrade to a paid tier if Stage 3 burns through credits.
#   - Search calls (mixed_companies / mixed_people) are NOT email reveals.
APOLLO_API_KEY=your_apollo_api_key_here
#
# Optional Stage 3 tuning (defaults baked into the script):
# JOBHUNT_STAGE3_PER_KIND_MIN=2
# JOBHUNT_STAGE3_PER_KIND_MAX=10
# JOBHUNT_STAGE3_BIGCO_EMPLOYEE_THRESHOLD=5000
# JOBHUNT_STAGE3_LIMIT=                 # (e.g. 1) cap PURSUE rows processed per run
# JOBHUNT_REGENERATE_CONTACTS=          # 1 = re-run for jobs that already have CONTACTS rows
#
# ── Optional / other ───────────────────────────────────────────────────────
# OPENAI_API_KEY=your_openai_key_here
