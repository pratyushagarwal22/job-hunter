# career-ops — Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# NOTE: Never commit secrets. `.env` is gitignored.
#
# ── Gemini Integration (Issue #344) ─────────────────────────────────────────
# Required for: node gemini-eval.mjs "JD text here"
# Free API key: https://aistudio.google.com/apikey
# Free tier: 15 RPM / 1M tokens/day with gemini-2.0-flash (no billing needed)
GEMINI_API_KEY=your_gemini_api_key_here
#
# Optional: Override default Gemini model
# GEMINI_MODEL=gemini-2.0-flash
#
# ── Google Sheets/Drive (service account) ────────────────────────────────────
# Used by the jobhunt automation pipeline (Command Center + Drive assets).
#
# Path should be relative to repo root or absolute.
GOOGLE_APPLICATION_CREDENTIALS=secrets/google-service-account.json
#
# Google Drive root folder (the JOBHUNT folder you created)
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_drive_folder_id_here
#
# Google Sheet ID (the "JOBHUNT Command Center" sheet)
GOOGLE_SHEET_ID=your_sheet_id_here

# ── Google Drive OAuth (recommended for personal Gmail) ───────────────────────
# Needed because service accounts can't upload into a user's "My Drive".
# 1) Put OAuth client JSON at GOOGLE_OAUTH_CLIENT_PATH
# 2) Run: node jobhunt/google-oauth-init.mjs
GOOGLE_OAUTH_CLIENT_PATH=secrets/google-oauth-client.json
GOOGLE_OAUTH_TOKEN_PATH=secrets/google-oauth-token.json
#
# ── Anthropic (Claude API) ──────────────────────────────────────────────────
# Required for: npm run jobhunt:claude-ping, jobhunt:ai-*, and npm run jobhunt:stage2 (Claude assets)
# Console: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
#
# Optional: fallback model if a task-specific var below is unset
# ANTHROPIC_MODEL=claude-haiku-4-5
#
# Optional: per-task models (JOBHUNT AI scripts — see jobhunt/ai-test/)
# ANTHROPIC_MODEL_SCORE=claude-sonnet-4-6
# ANTHROPIC_MODEL_LINKEDIN=claude-haiku-4-5
# ANTHROPIC_MODEL_RESUME=claude-opus-4-8
# ANTHROPIC_MODEL_RESUME_SUMMARY=claude-sonnet-4-6
# ANTHROPIC_MODEL_OUTREACH=claude-opus-4-8
# ANTHROPIC_MODEL_COVER_LETTER=claude-sonnet-4-6
#
# ── Apollo.io (Stage 3 contact enrichment) ──────────────────────────────────
# Required for: npm run jobhunt:stage3 (recruiter / hiring-manager lookup per company)
# Get a master API key (Settings → Integrations → API) — required by
# /v1/mixed_people/api_search. Basic plan ($59/mo) is the minimum tier where
# the API endpoints work; the Free plan returns 403 on every API endpoint.
#
# Credit model:
#   - /v1/mixed_people/api_search                : 0 credits (discovery only)
#   - /v1/people/bulk_match  (up to 10 contacts) : ~1 credit per net-new email
#   - /v1/people/match       (single fallback)   : ~1 credit per email
#   - reveal_phone_number=true                   : extra credits — we never set it
APOLLO_API_KEY=your_apollo_api_key_here
#
# Stage 3 — flow toggle
# Default ON: skip per-contact Claude generation, reuse Stage 2's outreach
# email + LinkedIn invite with a name-only swap. Flip to 0 once the per-contact
# Claude path is wired up again.
# JOBHUNT_STAGE3_ENRICH_ONLY=1
#
# Stage 3 — pagination caps (per kind, per job; recruiters and HMs counted separately)
# JOBHUNT_STAGE3_PER_KIND_DEFAULT_MAX=40   # Used when PER_COMPANY_TOTAL_MAX=0
# JOBHUNT_STAGE3_PER_KIND_PRIORITY_MAX=80  # Used when PER_COMPANY_TOTAL_MAX=0
# JOBHUNT_STAGE3_PER_COMPANY_TOTAL_MAX=50  # Default 50 in code; combined cap per company (bidirectional recruiter/HM fill); set 0 to use per-kind caps
# JOBHUNT_STAGE3_PER_KIND_MIN=2            # Soft floor — warn-only, never hard-fails
#
# Stage 3 — Apollo search filters (comma-separated lists)
# JOBHUNT_APOLLO_PERSON_LOCATIONS=United States,USA,United States of America,US
# JOBHUNT_APOLLO_CONTACT_EMAIL_STATUS=verified,likely to engage
#
# Stage 3 — bulk_match settings
# JOBHUNT_APOLLO_BULK_MATCH_BATCH=10       # Apollo hard-caps this at 10
# JOBHUNT_APOLLO_REVEAL_PERSONAL_EMAILS=0  # 1 = reveal personal emails too (extra credits + GDPR)
#
# Stage 3 — local dump directory (relative to career-ops/)
# JOBHUNT_STAGE3_DUMP_DIR=data/stage3
# CONTACTS_MASTER snapshots (history + contacts-master-latest.json)
# JOBHUNT_SNAPSHOTS_DIR=data/snapshots
#
# Stage 3 — misc
# JOBHUNT_STAGE3_LIMIT=                    # (e.g. 1) cap PURSUE rows processed per run; useful for dry-runs
# JOBHUNT_REGENERATE_CONTACTS=             # Legacy (CONTACTS tab removed); safe to ignore
#
# DEPRECATED — kept here for backward compatibility, but ignored when
# config/priority-companies.yml exists. The priority list replaces the
# employee-count heuristic so Stage 3 never has to call /organizations/enrich.
# JOBHUNT_STAGE3_BIGCO_EMPLOYEE_THRESHOLD=5000
# JOBHUNT_STAGE3_PER_KIND_MAX=10           # Renamed → JOBHUNT_STAGE3_PER_KIND_DEFAULT_MAX
#
# ── Stage 4 — LinkedIn profile import ───────────────────────────────────────
# Manual curated LinkedIn URLs → CONTACTS_MASTER (two-step: enrich then sync).
# Reuses APOLLO_API_KEY, GOOGLE_SHEET_ID, JOBHUNT_APOLLO_REVEAL_PERSONAL_EMAILS,
# JOBHUNT_APOLLO_BULK_MATCH_BATCH, JOBHUNT_SNAPSHOTS_DIR.
#
#   cp jobhunt/stage4/linkedin-profiles.example.txt jobhunt/stage4/linkedin-profiles.txt
#   npm run jobhunt:stage4-enrich
#   npm run jobhunt:stage4-sync
#
# JOBHUNT_STAGE4_DUMP_DIR=data/stage4
# JOBHUNT_STAGE4_MAX_URLS=100
#
# ── Google API rate limiting ───────────────────────────────────────────────
# Centralized at integrations/google/rate-limit.mjs. Every Sheets/Drive call
# from this project routes through a per-lane token bucket plus exponential
# backoff on 429 / 5xx / 403-with-quota-wording responses. Defaults are sized
# to stay comfortably under Google's 60 reads/min and 60 writes/min user
# quotas (and the 1M-quota-units/min Drive cap).
#
# Tokens per second per lane. 0.83 ≈ 50/min → 10/min headroom under the
# 60/min cap; raise only after you've measured retry counts in run reports.
# JOBHUNT_GOOGLE_SHEETS_QPS=0.83
# JOBHUNT_GOOGLE_DRIVE_QPS=3.33
#
# Burst budget per lane (tokens that accumulate while idle). Lets a stage
# fire `burst` calls back-to-back at startup before throttling kicks in.
# JOBHUNT_GOOGLE_SHEETS_BURST=10
# JOBHUNT_GOOGLE_DRIVE_BURST=30
#
# Retry policy (applies to every Sheets/Drive call). Backoff is
# baseMs * 2^attempt (capped at maxMs) plus up to 250ms jitter.
# JOBHUNT_GOOGLE_RETRY_MAX_ATTEMPTS=5
# JOBHUNT_GOOGLE_RETRY_BASE_MS=1000
# JOBHUNT_GOOGLE_RETRY_MAX_MS=32000
#
# ── Optional / other ───────────────────────────────────────────────────────
# OPENAI_API_KEY=your_openai_key_here
